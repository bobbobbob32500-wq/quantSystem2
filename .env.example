# 请复制为 .env（不要提交到git），并填入你自己的敏感配置

# Tushare Token（必填，若使用 tushare 数据源）
TUSHARE_TOKEN=

# 企业微信机器人 webhook（可选）
WECHAT_WEBHOOK=
POSITION_WECHAT_WEBHOOK=

# 可选：日志级别
LOG_LEVEL=INFO

# 可选：数据库路径（默认 data/database/quant_system.db）
# DATABASE_PATH=data/database/quant_system.db

# A股量化交易辅助系统 - 环境变量配置模板
# 复制此文件为 .env 并填入实际值

# ============================================
# 数据源配置
# ============================================

# Tushare Token (必填)
# 获取地址: https://tushare.pro 注册后在个人中心获取
TUSHARE_TOKEN=your_tushare_token_here

# ============================================
# 消息推送配置
# ============================================

# 企业微信机器人 Webhook (可选)
# 获取方式: 在企业微信群中添加群机器人，复制Webhook地址
WECHAT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_key_here

# 钉钉机器人 Webhook (可选)
DINGTALK_WEBHOOK=

# ============================================
# 系统配置
# =======

# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 数据库路径 (可选，默认使用内置路径)
# DATABASE_PATH=data/database/quant_system.db
=====================================