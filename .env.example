# A股量化交易辅助系统 - 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# 警告: .env 文件包含敏感信息，绝不可提交到版本控制

# ============================================
# 数据源配置
# ============================================

# Tushare Token (必填)
# 获取地址: https://tushare.pro 注册后在个人中心获取
TUSHARE_TOKEN=

# ============================================
# 消息推送配置
# ============================================

# 企业微信机器人 Webhook - 主推送通道 (可选)
# 获取方式: 在企业微信群中添加群机器人，复制Webhook地址
WECHAT_WEBHOOK=

# 企业微信机器人 Webhook - 持仓专用通道 (可选)
POSITION_WECHAT_WEBHOOK=

# 钉钉机器人 Webhook (可选)
DINGTALK_WEBHOOK=

# ============================================
# 系统配置
# ============================================

# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 数据库路径 (可选，默认使用内置路径)
# DATABASE_PATH=data/database/quant_system.db

# ============================================
# AI配置
# ============================================

# DeepSeek云端API密钥 (使用云端DeepSeek时必填)
# 获取地址: https://platform.deepseek.com/ 注册后创建API Key
DEEPSEEK_API_KEY=

# 本地DeepSeek R1认证密钥 (使用本地DeepSeek R1时选填，本地服务通常无需认证)
LOCAL_DEEPSEEK_API_KEY=
